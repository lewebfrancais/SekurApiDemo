# Copier ce fichier en .env.local (ignoré par git), puis renseigner l'URL et vos clés.
# Les clés se génèrent dans Réglages agence > API. Ne jamais les commiter.

# URL de l'API (obligatoire). https, ou http pour localhost / 127.0.0.1.
SEKUR_API_URL=https://api.sekur.fr

# Clé de niveau lecture : recommandée pour découvrir la démo.
SEKUR_API_KEY_READ=
# Clé de niveau lecture + écriture (nécessaire aux écritures).
SEKUR_API_KEY_WRITE=
# Clé de niveau lecture + écriture + suppression (nécessaire aux DELETE).
SEKUR_API_KEY_DELETE=

# Lecture seule par défaut. Les écritures portent sur les données réelles de l'agence.
DEMO_ALLOW_WRITES=false
# Scénarios de rafale (429) et de corps trop gros (413), qui bloquent le quota de l'agence.
DEMO_ALLOW_STRESS=false

# Application Sekur, pour le lien vers l'Historique des actions (https://platform.sekur.fr par défaut).
SEKUR_APP_URL=https://platform.sekur.fr
